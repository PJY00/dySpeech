  "components": {
    "schemas": {
      "AgcSignal": {
        "type": "string",
        "enum": [
          "agc_steps",
          "agc_hold",
          "agc_toggle"
        ],
        "title": "AgcSignal",
        "description": "자동 게인 조절 시험 소리. 시험 소리 정답값 파일의 이름과 같다."
      },
      "BaselinePoint": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid4",
            "title": "Session Id"
          },
          "value": {
            "type": "number",
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "value"
        ],
        "title": "BaselinePoint"
      },
      "ChangeStatus": {
        "type": "string",
        "enum": [
          "no_data",
          "low_reliability",
          "pending_mdc",
          "no_change",
          "increase",
          "decrease"
        ],
        "title": "ChangeStatus"
      },
      "CompleteAccepted": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid4",
            "title": "Session Id"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "status"
        ],
        "title": "CompleteAccepted"
      },
      "CompleteIn": {
        "properties": {
          "ended_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ended At"
          },
          "device_measurements": {
            "items": {
              "$ref": "#/components/schemas/DeviceMeasurement"
            },
            "type": "array",
            "title": "Device Measurements"
          },
          "game_runs": {
            "items": {
              "$ref": "#/components/schemas/GameRun"
            },
            "type": "array",
            "title": "Game Runs"
          },
          "client_meta": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Client Meta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ended_at"
        ],
        "title": "CompleteIn"
      },
      "Decision": {
        "type": "string",
        "enum": [
          "up",
          "down",
          "hold",
          "deferred"
        ],
        "title": "Decision"
      },
      "DesiredDirection": {
        "type": "string",
        "enum": [
          "up",
          "down",
          "none"
        ],
        "title": "DesiredDirection"
      },
      "DeviceMeasurement": {
        "properties": {
          "metric": {
            "$ref": "#/components/schemas/Metric"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "low_reliability": {
            "type": "boolean",
            "title": "Low Reliability",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "metric",
          "value",
          "unit"
        ],
        "title": "DeviceMeasurement"
      },
      "DeviceSessionMeasurements": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid4",
            "title": "Session Id"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "measurements": {
            "items": {
              "$ref": "#/components/schemas/DeviceMeasurement"
            },
            "type": "array",
            "title": "Measurements"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "started_at",
          "measurements"
        ],
        "title": "DeviceSessionMeasurements"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "SESSION_NOT_FOUND"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "FieldError": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "examples": [
              "body.recordings[1].trial_no"
            ]
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "examples": [
              "mpt_trial 녹음에는 trial_no 값이 필요합니다"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "reason"
        ],
        "title": "FieldError"
      },
      "GameRun": {
        "properties": {
          "game_run_id": {
            "type": "string",
            "format": "uuid4",
            "title": "Game Run Id"
          },
          "game": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Game"
          },
          "level": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Level"
          },
          "round_index": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Round Index"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "params": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
