    "/v1/sessions/{session_id}/complete": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "세션 완료",
        "operationId": "post_complete_v1_sessions__session_id__complete_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid4",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteIn"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompleteAccepted"
                }
              }
            }
          },
          "401": {
            "description": "X-App-Key가 없거나 맞지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "요청 본문이 1 MB를 넘음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "세션 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "올라오지 않은 녹음이 있음. missing_recording_ids의 파일만 다시 올리고 재요청",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissingRecordingsResponse"
                }
              }
            }
          },
          "422": {
            "description": "요청이 API 명세와 다름(VALIDATION_ERROR, fields에 문제 필드의 경로와 이유), 또는 올린 WAV가 규격과 다름(INVALID_RECORDING_FORMAT, invalid_recordings에 녹음 ID와 이유)",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ValidationErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/InvalidRecordingsResponse"
                    }
                  ],
                  "title": "Response 422 Post Complete V1 Sessions  Session Id  Complete Post"
                }
              }
            }
          }
        }
      }
    },
