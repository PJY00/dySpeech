# 서버 설정 목록. 이 파일을 backend/.env로 복사해 값을 넣는다.
# backend/.env는 커밋하지 않는다.
# 배포 서버(Railway)에서는 같은 이름으로 환경 변수 화면에 넣는다.

# ---- 운영 변수 ----

# Supabase PostgreSQL 연결 문자열(Session pooler). postgresql://로 시작하는 형식
DATABASE_URL=

# S3 버킷 리전. 서울 리전은 ap-northeast-2
AWS_REGION=

# 녹음 버킷 전용 IAM 사용자의 접근 키
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 녹음 파일을 저장하는 S3 버킷 이름
S3_BUCKET=

# 앱 요청을 확인하는 임의 문자열.
# 앱 파일에서 꺼낼 수 있어 진짜 비밀은 아니다(과제 시연 수준).
APP_API_KEY=

# ---- 개발 변수 ----

# 로컬 테스트 DB. 예: postgresql://<사용자 이름>@localhost:5432/dyspeech_test
# 비워 두면 DB 테스트는 건너뛴다. DB 이름이 dyspeech_test가 아니면 테스트를 중단한다.
TEST_DATABASE_URL=
